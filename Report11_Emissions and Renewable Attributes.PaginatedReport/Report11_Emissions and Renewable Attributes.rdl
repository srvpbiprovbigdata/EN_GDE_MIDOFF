  <DataSources>
    <DataSource Name="ICOM_MER_ADMINIS">
      <rd:SecurityType>DataBase</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>ORACLE</DataProvider>
        <ConnectString>DATA SOURCE=ICOMSEC.EHN.ES</ConnectString>
        <Prompt>Especifique un nombre de usuario y una contraseña para el origen de datos ICOM_MER_ADMINIS:</Prompt>
      </ConnectionProperties>
      <rd:DataSourceID>1284059c-a4a1-42dd-8fe1-1548ad022fa0</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Emissions">
      <Query>
        <DataSourceName>ICOM_MER_ADMINIS</DataSourceName>
        <QueryParameters>
          <QueryParameter Name=":fechainicio">
            <Value>=Parameters!fechainicio.Value</Value>
          </QueryParameter>
          <QueryParameter Name=":fechafin">
            <Value>=Parameters!fechafin.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT EFFECTIVE_AT,GC_POLAND,
CASE WHEN LGCs_Australia is null THEN 'N.A.' ELSE TO_CHAR(LGCs_Australia) END as LGCs_Australia, EUA
FROM
(
    SELECT EFFECTIVE_AT, ROUND(TO_NUMBER("'PXPRMOCO'", 'FM'||REGEXP_REPLACE("'PXPRMOCO'",'\d','0')),2)  GC_POLAND,   
    --CASE WHEN ROUND(TO_NUMBER("'REC_SPOT'", 'FM'||REGEXP_REPLACE("'REC_SPOT'",'\d','0')),2) is null then 'N.A.' else 
    --ROUND(TO_NUMBER("'REC_SPOT'", 'FM'||REGEXP_REPLACE("'REC_SPOT'",'\d','0')),2) END as  LGCs_Australia,
    ROUND(TO_NUMBER("'REC_SPOT'", 'FM'||REGEXP_REPLACE("'REC_SPOT'",'\d','0')),2) as  LGCs_Australia,    
    ROUND(TO_NUMBER("'ICEDEU3'", 'FM'||REGEXP_REPLACE("'ICEDEU3'",'\d','0')),2)  EUA 
    FROM (  
        select EFFECTIVE_AT, instrument, FIELDCODE,CASE WHEN min_effective_at_value = 'N.A.' THEN NULL ELSE min_effective_at_value END AS min_effective_at_value
        FROM (  
            SELECT 
            min(EFFECTIVE_AT) EFFECTIVE_AT,INSTRUMENT, FIELDCODE, 
            min(fieldvalue) keep (dense_rank first order by EFFECTIVE_AT ) min_effective_at_value  
            from MER_INTERNATIONAL.TB_BLOOMBERG_DATA  
            where fieldcode ='PX_LAST' 
            and instrument in ( 'PXPRMOCO', 'REC_SPOT', 'ICEDEU3') 
            AND trunc(EFFECTIVE_AT) BETWEEN :fechainicio AND :fechafin  
            group by trunc(EFFECTIVE_AT),INSTRUMENT, FIELDCODE  
        )
    )PIVOT  (min(min_effective_at_value) for instrument in ( 'PXPRMOCO', 'REC_SPOT', 'ICEDEU3'))   
)</CommandText>
      </Query>
      <Fields>
        <Field Name="EFFECTIVE_AT">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>EFFECTIVE_AT</DataField>
        </Field>
        <Field Name="GC_POLAND">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>GC_POLAND</DataField>
        </Field>
        <Field Name="LGCS_AUSTRALIA">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>LGCS_AUSTRALIA</DataField>
        </Field>
        <Field Name="EUA">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>EUA</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
