  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="ICOM_MER_ADMINIS">
      <rd:SecurityType>DataBase</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>ORACLE</DataProvider>
        <ConnectString>DATA SOURCE=ICOMSEC.EHN.ES</ConnectString>
        <Prompt>Especifique un nombre de usuario y una contraseña para el origen de datos ICOM_MER_ADMINIS:</Prompt>
      </ConnectionProperties>
      <rd:DataSourceID>14782f71-e657-469d-90bd-9299916cb1ce</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>ICOM_MER_ADMINIS</DataSourceName>
        <QueryParameters>
          <QueryParameter Name=":startDate">
            <Value>=Parameters!startDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name=":endDate">
            <Value>=Parameters!endDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH
    -- 1. Precios AGREGADOS POR DÍA (calcula la media diaria SIN * 10)
    Precios_Dia AS (
        SELECT
            TRUNC(PROG_DATE) AS FECHA,
            AVG(NVL(VALUE, 0)) AS "Precio España - PMD"
        FROM
            MER_INTERNATIONAL.MER_V_COMMON_DATA
        WHERE
            COD_FILE = 'PRECIOSPDBC_ES'
            AND PROG_DATE BETWEEN :startDate AND :endDate
        GROUP BY
            TRUNC(PROG_DATE) 
    ),
    -- 2. Energía de adquisición AGREGADA POR DÍA (calcula el sumatorio diario / 10)
    Energia_Adquisicion_Dia AS (
        SELECT
            TRUNC(FECHA_PROG) AS FECHA,
            SUM((VALOR) / 10)*2.5 AS "Energía de adquisición"
        FROM
            MER_ADMINIS.MER_LIQ_TOT_PROG_TOTAL_QH
        WHERE
            COD_FICHERO = 'PDBF_TOT'
            AND COD_TIPO_DATO = 'Total Compras'
            AND COD_TIPO_OFERTA = 'ES'
            AND FECHA_PROG BETWEEN :startDate AND :endDate
        GROUP BY
            TRUNC(FECHA_PROG)
    ),
    -- Resto de bloques diarios sin cambios...
    Prevision_Demanda_D AS (
        SELECT FECHA_PROG, CASE WHEN NVL(sum(H24),0)=0 and extract(MONTH FROM(FECHA_PROG))=3 THEN (SUM(H1+H2+H3+H4+H5+H6+H7+H8+H9+H10+H11+H12+H13+H14+H15+H16+H17+H18+H19+H20+H21+H22+H23)) WHEN sum(H25)&gt;0 and extract(MONTH FROM(FECHA_PROG))=10 THEN (SUM(H1+H2+H3+H4+H5+H6+H7+H8+H9+H10+H11+H12+H13+H14+H15+H16+H17+H18+H19+H20+H21+H22+H23+H24+H25)) ELSE (SUM(H1+H2+H3+H4+H5+H6+H7+H8+H9+H10+H11+H12+H13+H14+H15+H16+H17+H18+H19+H20+H21+H22+H23+H24)) END as "Previsión demanda" FROM MER_ADMINIS.MER_LIQ_PROG_BAL_ELEC_DIARIO WHERE COD_FICHERO='BALPREVDEDD' AND COD_BALANCE = 'Previsión diaria id 460' AND FECHA_PROG BETWEEN :startDate AND :endDate GROUP BY FECHA_PROG
    ),
    Prevision_Eolica_D AS (
        SELECT FECHA_PROG, CASE WHEN NVL(sum(H24),0)=0 and extract(MONTH FROM(FECHA_PROG))=3 THEN (SUM(H1+H2+H3+H4+H5+H6+H7+H8+H9+H10+H11+H12+H13+H14+H15+H16+H17+H18+H19+H20+H21+H22+H23)) WHEN sum(H25)&gt;0 and extract(MONTH FROM(FECHA_PROG))=10 THEN (SUM(H1+H2+H3+H4+H5+H6+H7+H8+H9+H10+H11+H12+H13+H14+H15+H16+H17+H18+H19+H20+H21+H22+H23+H24+H25)) ELSE (SUM(H1+H2+H3+H4+H5+H6+H7+H8+H9+H10+H11+H12+H13+H14+H15+H16+H17+H18+H19+H20+H21+H22+H23+H24)) END as "Previsión eólica" FROM MER_ADMINIS.MER_LIQ_PROG_BAL_ELEC_DIARIO WHERE COD_FICHERO='BALPREVPENDD' AND COD_BALANCE = 'Previsión eólica id 541' AND FECHA_PROG BETWEEN :startDate AND :endDate GROUP BY FECHA_PROG
    ),
    Energia_Tecnologias_D AS (
        SELECT FECHA_PROG, SUM(VALOR) As "Energía diaria por tecnologías" FROM MER_ADMINIS.MER_LIQ_PBC_TECNO WHERE COD_FICHERO = 'INT_PBC_TECNOLOGIAS' AND SISTEMA = 'ESPAÑA' AND TECNOLOGIA IN ('EÓLICA', 'SOLAR TÉRMICA', 'SOLAR FOTOVOLTAICA', 'COGENERACIÓN/RESIDUOS/MINI HIDRA') AND FECHA_PROG BETWEEN :startDate AND :endDate GROUP BY FECHA_PROG
    ),
    Produccion_Detalle_D AS (
        SELECT FECHA_PROG, SUM(CASE WHEN COD_TIPO_DATO IN ('Nuclear') THEN VALOR END) AS "Producción nuclear", SUM(CASE WHEN COD_TIPO_DATO IN ('Hidráulica','Turbinación bombeo') THEN VALOR END) AS "Producción hidráulica", SUM(CASE WHEN COD_TIPO_DATO IN ('Eólica','Solar térmica','Solar fotovoltaica','Cogeneración','Otras renovables','Residuos renovables') THEN VALOR END) AS "Producción régimen especial", SUM(CASE WHEN COD_TIPO_DATO IN ('Demanda en b.c.') THEN VALOR END) AS "Demanda en b.c.", SUM(CASE WHEN COD_TIPO_DATO IN ('Eólica') THEN VALOR END) AS "Producción eólica", SUM(CASE WHEN COD_TIPO_DATO IN ('Solar fotovoltaica', 'Solar térmica') THEN VALOR END) AS "Producción solar" FROM MER_LIQ_PROG_BAL_ELEC_REEDATA WHERE COD_FICHERO = 'balance-electrico' AND TIPO_AGR = 'DIARIA' AND TIPO_VALOR = 'A' AND FECHA_PROG BETWEEN :startDate AND :endDate GROUP BY FECHA_PROG
    )
-- UNIÓN FINAL (SOLO POR FECHA)
SELECT
    A.FECHA AS FECHA_PROG,
    CASE
        WHEN A."Precio España - PMD" IS NOT NULL THEN ROUND(A."Precio España - PMD", 2)
        ELSE NULL
    END AS "Precio España - PMD",
    ROUND(B."Energía de adquisición", 1) AS "Energía de adquisición",
    C."Previsión demanda", D."Previsión eólica", E."Energía diaria por tecnologías",
    F."Producción nuclear", F."Producción hidráulica", F."Producción régimen especial",
    F."Demanda en b.c.", F."Producción eólica", F."Producción solar"
FROM
    Precios_Dia A
LEFT JOIN Energia_Adquisicion_Dia B ON A.FECHA = B.FECHA
LEFT JOIN Prevision_Demanda_D C ON A.FECHA = C.FECHA_PROG
LEFT JOIN Prevision_Eolica_D D ON A.FECHA = D.FECHA_PROG
LEFT JOIN Energia_Tecnologias_D E ON A.FECHA = E.FECHA_PROG
LEFT JOIN Produccion_Detalle_D F ON A.FECHA = F.FECHA_PROG
ORDER BY
    A.FECHA</CommandText>
      </Query>
      <Fields>
        <Field Name="FECHA_PROG">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>FECHA_PROG</DataField>
        </Field>
        <Field Name="Precio_España___PMD">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>Precio España - PMD</DataField>
        </Field>
        <Field Name="Energía_de_adquisición">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>Energía de adquisición</DataField>
        </Field>
        <Field Name="Previsión_demanda">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>Previsión demanda</DataField>
        </Field>
        <Field Name="Previsión_eólica">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>Previsión eólica</DataField>
        </Field>
        <Field Name="Energía_diaria_por_tecnologías">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>Energía diaria por tecnologías</DataField>
        </Field>
        <Field Name="Producción_nuclear">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>Producción nuclear</DataField>
        </Field>
        <Field Name="Producción_hidráulica">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>Producción hidráulica</DataField>
        </Field>
        <Field Name="Producción_régimen_especial">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>Producción régimen especial</DataField>
        </Field>
        <Field Name="Demanda_en_b_c_">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>Demanda en b.c.</DataField>
        </Field>
        <Field Name="Producción_eólica">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>Producción eólica</DataField>
        </Field>
        <Field Name="Producción_solar">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>Producción solar</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
